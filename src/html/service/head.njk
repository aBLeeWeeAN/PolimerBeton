<!-- ! DO NOT REMOVE THIS NUNJUCKS IMPORTS | PART OF GULP BUILD !!! --->
{% from "macros/macro__hreflang_tags.njk" import hreflang_tags %}
{% from "macros/macro__inline_script.njk" import inline_script %}

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- * BLOCK PHONE NUMBER, DATE, ADDRESS & EMAIL AS LINK DETECTION --->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />

    <!-- ! DO NOT REMOVE THIS NUNJUCKS BLOCK !!! | PAGE LOCALE TAGS --->
    {% if allAvailableLocales and defaultLocale and siteUrl %}
        {{
            hreflang_tags(
                site_url = siteUrl,
                all_locales = allAvailableLocales,
                default_locale = defaultLocale
            )
        }}
    {% endif %}

    <!-- * Page title --->
    <title>{{ current_page_head.title }}</title>

    <!-- * Page description & keywords --->
    <meta name="description" content="{{ current_page_head.description }}" />
    <meta name="keywords" content="{{ current_page_head.keywords }}" />

    <!-- * Authors --->
    <link rel="author" href="@meta/humans.txt" />

    <!-- * Page favicon --->
    <link rel="icon" type="image/png" href="@meta/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="@meta/favicon.svg" />
    <link rel="shortcut icon" href="@meta/favicon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="@meta/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PB VRN" />

    <link rel="manifest" href="@meta/site.webmanifest" />

    <!-- * Open Graph --->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="{{ page_locale }}" />

    <meta property="og:url" content="{{ page_url }}" />
    <meta property="og:title" content="{{ common.head.title }}" />
    <meta property="og:description" content="{{ common.head.description }}" />

    <meta property="og:image" content="{{ common.head.opengraph_image_url }}" />
    <meta property="og:image:alt" content="{{ common.head.open_graph_image.alt }}" />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- * Canonical --->
    <link rel="canonical" href="{{ page_url }}" />

    <!-- * If JS supports -> enable JS classes - -->
    <script>
        document.documentElement.classList.remove('no-js')
        document.documentElement.classList.add('js')
    </script>

    <!-- * Set current page name to body -->
    <script>
        const pageName =
            window.location.pathname
                .split('/')
                .pop()
                .replace(/\.[^/.]+$/, '') || 'home'
        document.documentElement.classList.add(`page-${pageName}`)
    </script>

    <!-- * 0. Inject inline avif/webp script polyfill --->
    <!-- ! STRONGLY RECOMMENDED PLACE IT BEFORE ANY CSS FILES --->
    {{ inline_script('node_modules/gulp-web-images-css/plugin.js') }}

    <!-- * 1. Inject inline critical-css --->
    <!-- ! DO NOT REMOVE THIS COMMENT !!! | CRITICAL CSS PLACEHOLDER --->

    <!-- * 2. Import vendors CSS --->
    <!-- empty --->

    <!-- ! DO NOT REMOVE THIS COMMENT !!! | INLINE CSS START | DISABLED BY DEFAULT --->
    <!-- * 3. Import my CSS --->
    <link rel="preload" href="@scss/main.scss" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <!-- * 3.1. Fallback (if JS disable) --->
    <noscript>
        <link rel="stylesheet" href="@scss/main.scss" />
    </noscript>
    <!-- ! DO NOT REMOVE THIS COMMENT !!! | INLINE CSS END --->
</head>
