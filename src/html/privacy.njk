{% extends "base/base.njk" %}

<!-- ? название текущей страницы в домене --->
{% set current_page__page_name = 'privacy' %}

<!-- ? передаем текстовые данные из файла переовдов *.json для <head> этой страницы -->
{% set current_page__head_content = privacy.head %}

{% block content %}
    <div class="my-shadow-group">
        <section id="privacy" class="my-privacy">
            <div class="container my-wrapper">
                <div class="row justify-content-center">
                    <h1 class="my-title my-title--privacy">{{ privacy.privacy_policy.heading }}</h1>
                </div>

                <div class="row">
                    <nav class="my-table-of-contents" aria-label="{{ privacy.privacy_policy.toc.a11y__aria_label }}">
                        <details class="my-table-of-contents__details">
                            <summary class="my-table-of-contents__summary">
                                <svg class="my-table-of-contents__summary-svg" width="16" height="16" aria-hidden="true">
                                    <use href="@icons/other/summary-details-block.svg"></use>
                                </svg>
                                <h3 class="my-subtitle my-subtitle--table-of-contents">{{ privacy.privacy_policy.toc.title }}</h3>
                            </summary>

                            <ol class="my-table-of-contents__list">
                                {% for section in privacy.privacy_policy.sections %}
                                    {% set sectionIndex = loop.index %}

                                    {% if section.content.type == "grouped_list" and section.content.groups %}
                                        <!-- Пункты со вложенными подсписками (разделы 3, 4) -->
                                        <li class="my-table-of-contents__list-item">
                                            <details class="my-table-of-contents__nested-details">
                                                <summary class="my-table-of-contents__nested-summary">
                                                    <svg
                                                        class="my-table-of-contents__nested-summary-svg"
                                                        width="16"
                                                        height="16"
                                                        aria-hidden="true">
                                                        <use href="@icons/other/summary-details-block.svg"></use>
                                                    </svg>
                                                    <a
                                                        class="my-link my-link--table-of-contents my-link--disable-transform"
                                                        href="#privacy-section-{{ sectionIndex }}">
                                                        {{ sectionIndex }}. {{ section.title }}
                                                    </a>
                                                </summary>

                                                <ol class="my-table-of-contents__list">
                                                    {% for group in section.content.groups %}
                                                        <li class="my-table-of-contents__list-item">
                                                            <a
                                                                class="my-link my-link--table-of-contents"
                                                                href="#privacy-section-{{ sectionIndex }}-{{ loop.index }}">
                                                                {{ sectionIndex }}.{{ loop.index }}.
                                                                {{ group.title | replace(":", "") | trim }}
                                                            </a>
                                                        </li>
                                                    {% endfor %}
                                                </ol>
                                            </details>
                                        </li>
                                    {% else %}
                                        <!-- Обычные одиночные пункты -->
                                        <li class="my-table-of-contents__list-item">
                                            <a class="my-link my-link--table-of-contents" href="#privacy-section-{{ sectionIndex }}">
                                                {{ sectionIndex }}. {{ section.title }}
                                            </a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ol>
                        </details>
                    </nav>
                </div>

                <div class="row">
                    <ol class="my-list my-list--numeric">
                        {% for section in privacy.privacy_policy.sections %}
                            {% set sectionIndex = loop.index %}

                            <li class="my-list__item">
                                <h3 id="privacy-section-{{ loop.index }}" class="my-subtitle my-subtitle--privacy">{{ section.title }}</h3>

                                {% if section.paragraph and section.paragraph | length > 0 %}
                                    <p class="my-paragraph my-paragraph--in-list">{{ section.paragraph }}</p>
                                {% endif %}

                                {% if section.content %}
                                    <!-- ВАРИАНТ 1: Простой нумерованный список (как в пункте 1) --->
                                    {% if section.content.type == "ordered_list" %}
                                        <ol class="my-list__sub-list">
                                            {% for item in section.content.items %}
                                                <li class="my-list__item my-paragraph my-paragraph--in-list">
                                                    {% if item | isArray %}
                                                        <!-- Если item — это массив строк (несколько абзацев в одном li) -->
                                                        {% for sub_item in item %}
                                                            {{ sub_item }}
                                                            {% if not loop.last %}<br />{% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <!-- Если item — обычная строка -->
                                                        {{ item }}
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ol>

                                        <!-- ВАРИАНТ 2: Сложные нумерованные списки с вложенными ненумерованными списками (как в пункте 3) --->
                                    {% elif section.content.type == "grouped_list" %}
                                        <ol class="my-list__sub-list my-list__sub-list--with-nested-list">
                                            {% for group in section.content.groups %}
                                                <li class="my-list__item">
                                                    <h4
                                                        id="privacy-section-{{ sectionIndex }}-{{ loop.index }}"
                                                        class="my-subtitle my-subtitle--privacy-small">
                                                        {{ group.title }}
                                                    </h4>
                                                    {% if group.items and group.items | length > 0 %}
                                                        <ul class="my-list__sub-sub-list">
                                                            {% for item in group.items %}
                                                                <li class="my-list__item my-paragraph my-paragraph--in-list">{{ item }}</li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ol>

                                        <!-- ВАРИАНТ 3: Только таблица (как в пункте 6) --->
                                    {% elif section.content.type == "table" %}
                                        <div class="my-table-wrapper">
                                            <table class="my-table">
                                                <tbody class="my-table__body">
                                                    {% for row in section.content.rows %}
                                                        <tr class="my-table__row">
                                                            <td class="my-table__item-header">
                                                                <strong class="my-paragraph my-paragraph--strong">{{ row.label }}</strong>
                                                            </td>
                                                            <td class="my-table__item">
                                                                <ul class="my-list my-list--bullet">
                                                                    {% for item in row.items %}
                                                                        <li class="my-list__item my-paragraph my-paragraph--in-table">
                                                                            {{ item }}
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- * ВАРИАНТ 4: Только параграф (как в пункте 11) --->
                                        {# {% elif section.content.type == "paragraph" %} #}
                                    {% endif %}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </section>

        <section id="cookie-policy" class="my-cookie-policy">
            <div class="container my-wrapper">
                <div class="row justify-content-center">
                    <h2 class="my-title my-title--cookie-policy">{{ privacy.cookie_policy.heading }}</h2>
                </div>

                <div class="row">
                    {% for section in privacy.cookie_policy.sections %}
                        {% if section.title and section.title | length > 0 %}
                            <h3 class="my-subtitle my-subtitle--privacy">{{ section.title }}</h3>
                        {% endif %}

                        {% if section.paragraph and section.paragraph | length > 0 %}
                            <p class="my-paragraph my-paragraph--privacy">{{ section.paragraph }}</p>
                        {% endif %}

                        {% if section.content %}
                            <!-- ВАРИАНТ 1: Простой параграф --->
                            {% if section.content.type == "paragraphs" %}
                                {% for item in section.content.items %}
                                    <p class="my-paragraph my-paragraph--privacy">{{ item }}</p>
                                {% endfor %}

                                <!-- ВАРИАНТ 2: Параграф с ненумерованным списком --->
                            {% elif section.content.type == "paragraphs_with_list" %}
                                {% for item in section.content.items %}
                                    <p class="my-paragraph my-paragraph--privacy">{{ item.paragraph }}</p>

                                    {% if item.list and item.list | length > 0 %}
                                        <ul class="my-list my-list--dashed">
                                            {% for item_from_list in item.list %}
                                                <li class="my-list__item my-paragraph my-paragraph--in-list">{{ item_from_list }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>
{% endblock %}
